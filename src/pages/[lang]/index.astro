---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import TripBuilder from '../../components/TripBuilder.astro';
import TruthSection from '../../components/TruthSection.astro';
import ToursShowcase from '../../components/ToursShowcase.astro';
import FAQ from '../../components/FAQ.astro';
import Footer from '../../components/Footer.astro';
import { LANG_DATA } from '../../i18n/langData';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'it' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'de' } }
  ];
}

const { lang } = Astro.params;
const data = LANG_DATA[lang] || LANG_DATA.es;
---

<Layout title={data.title} description={data.description} lang={lang}>
  <Header data={data} lang={lang} />
  <main>
    <Hero data={data} />
    <TripBuilder lang={lang} />
    <TruthSection data={data} />
    <ToursShowcase data={data} lang={lang} />
    <FAQ data={data} lang={lang} />
  </main>
  <Footer data={data} lang={lang} />
</Layout>
